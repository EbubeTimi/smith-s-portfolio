      "kind": "button",
      "description": "Brand context selector; selected state is white.",
      "html": "<div class=\"ds-tabs\"><button class=\"ds-brand ds-focus\" aria-pressed=\"true\">NorthQuest</button><button class=\"ds-brand ds-focus\" aria-pressed=\"false\">CashDrive</button></div>",
      "css": ".ds-tabs{display:flex;gap:5px;padding:12px;background:#eef0ed;border-bottom:1px solid #cbd3cc}.ds-brand{border:0;font:11px Manrope,Arial,sans-serif;padding:9px 12px;border-radius:6px;color:#334c3e;background:transparent;min-height:44px;cursor:pointer}.ds-brand[aria-pressed=true]{background:white}.ds-focus:focus-visible{outline:3px solid #498564;outline-offset:5px}"
