      "html": "<div class=\"ds-screen\"><button class=\"ds-film\" aria-label=\"Play EMMA\"><span>Watch EMMA</span><span class=\"ds-play\" aria-hidden=\"true\">Play</span></button></div>",
      "css": ".ds-screen{position:relative;background:#1c2a21;border-radius:10px;overflow:hidden;height:330px}.ds-film{position:absolute;inset:0;width:100%;border:0;color:white;background:linear-gradient(transparent 50%,#0009);display:flex;align-items:end;justify-content:space-between;padding:18px;font:700 14px Manrope,Arial,sans-serif;text-align:left;cursor:pointer}.ds-play{width:43px;height:43px;border:1px solid #ffffff90;border-radius:50%;display:grid;place-items:center;font-size:11px}.ds-film:focus-visible{outline:3px solid white;outline-offset:-6px;box-shadow:inset 0 0 0 9px #172421}"
    }
