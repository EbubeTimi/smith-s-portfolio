      "refersTo": "button-primary",
      "description": "Forest action used by the demo and case links.",
      "html": "<button class=\"ds-primary ds-focus\">Log sample video</button>",
      "css": ".ds-primary{background:var(--green,#185541);color:white;border:0;border-radius:8px;padding:12px 19px;min-height:46px;font:700 13px Manrope,Arial,sans-serif;cursor:pointer;transition:background .2s}.ds-primary:hover{background:#103e2e}.ds-primary:disabled{opacity:.58;cursor:default}.ds-focus:focus-visible{outline:3px solid #498564;outline-offset:5px}"
    },
    {
      "name": "Reset action",
      "kind": "button",
      "refersTo": "button-reset",
      "description": "Quiet reset next to the primary demo action.",
      "html": "<button class=\"ds-reset ds-focus\">Reset</button>",
      "css": ".ds-reset{border:0;background:transparent;color:var(--muted,#56625d);font:14px Manrope,Arial,sans-serif;text-decoration:underline;text-underline-offset:4px;min-height:44px;cursor:pointer}.ds-focus:focus-visible{outline:3px solid #498564;outline-offset:5px}"
    },
    {
      "name": "Navigation",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "Restrained glass navigation with an ink contact action.",
      "html": "<nav class=\"ds-nav\"><a class=\"ds-focus\" href=\"#work\">Work</a><a class=\"ds-focus\" href=\"#films\">Films</a><a class=\"ds-contact ds-focus\" href=\"#contact\">Let’s talk</a></nav>",
      "css": ".ds-nav{display:flex;align-items:center;gap:28px;padding:12px 20px;border-radius:14px;background:rgba(255,255,255,.91);backdrop-filter:blur(18px);box-shadow:0 5px 24px #14281b0c;font-family:Manrope,Arial,sans-serif}.ds-nav a{display:inline-flex;align-items:center;min-height:44px;color:var(--ink,#172421);font-size:13px;text-decoration:none}.ds-nav a:hover{text-decoration:underline}.ds-nav .ds-contact{background:var(--ink,#172421);color:white;padding:10px 17px;border-radius:8px}@media(prefers-reduced-transparency:reduce){.ds-nav{background:white;backdrop-filter:none}}.ds-focus:focus-visible{outline:3px solid #498564;outline-offset:5px}"
    },
    {
      "name": "Tool badge",
      "kind": "chip",
      "refersTo": "tool",
      "description": "Static inline tool label.",
      "html": "<span class=\"ds-tool\">Codex</span>",
      "css": ".ds-tool{display:inline-block;font:12px Manrope,Arial,sans-serif;color:var(--ink,#172421);background:#eef0ec;border-radius:30px;padding:7px 12px}"
    },
    {
      "name": "Work specimen",
      "kind": "card",
      "refersTo": "sample-card",
      "description": "Pale mint sample that straightens on hover.",
      "html": "<a class=\"ds-sample ds-focus\" href=\"#work\">Sample creator record<strong class=\"ds-amount\">₦30,000</strong><span>Fictional demo</span></a>",
      "css": ".ds-sample{display:block;background:var(--mint,#e9f2ec);color:var(--ink,#172421);padding:25px 20px;border-radius:12px;transform:rotate(-3deg);text-decoration:none;box-shadow:0 16px 35px #14281b0d;transition:transform .4s var(--ease,cubic-bezier(.16,1,.3,1));font:12px Manrope,Arial,sans-serif}.ds-amount{font-size:23px;display:block;line-height:1.3;margin:25px 0 7px}.ds-sample:hover{transform:rotate(0)}@media(prefers-reduced-motion:reduce){.ds-sample{transform:none;transition:none}}.ds-focus:focus-visible{outline:3px solid #498564;outline-offset:5px}"
    },
    {
      "name": "Review textarea",
      "kind": "input",
      "refersTo": "review-field",
      "description": "Local preview notes, with no submission backend.",
      "html": "<label class=\"ds-label\" for=\"ds-notes\">Review notes (not sent)</label><textarea class=\"ds-field ds-focus\" id=\"ds-notes\" placeholder=\"What should change?\"></textarea>",
      "css": ".ds-label{display:block;font:12px Manrope,Arial,sans-serif;color:var(--ink,#172421)}.ds-field{width:100%;height:65px;padding:8px;border:1px solid var(--line,#d9e0db);border-radius:4px;font:12px Manrope,Arial,sans-serif;caret-color:var(--green,#185541)}.ds-focus:focus-visible{outline:3px solid #498564;outline-offset:5px}"
    },
